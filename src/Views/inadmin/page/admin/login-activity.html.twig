{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    {% if user|default(null) %}
    <a href="{{ path('incc_admin_list') }}">Users</a>
    <span>Edit User</span>
    {% else %}
    <span>Audit Logs</span>
    {% endif %}
{% endblock pagetitle %}

{% block content %}

<div class="col-12 widget-data-list">
    {% if user|default(null) %}
        {% include 'inadmin/partials/tab-sets/profile.html.twig' with { activeTab: 'login-activity' } %}
    {% else %}
        {% include 'inadmin/partials/tab-sets/users.html.twig' %}
    {% endif %}

    {% if user|default(null) %}
        {% set path = 'incc_admin_login_activity_view' %}
        {% set path_params = { username: 'user.username', id: 'item.id', } %}
        {% set show_search = false %}
    {% else %}
        {% set path = 'incc_admin_all_login_activity_view' %}
        {% set path_params = { id: 'item.id', } %}
        {% set show_search = true %}
    {% endif %}

    {% include 'inadmin/partials/components/view_content.html.twig' with {
        type: 'LoginActivity',

        table_name: 'Login Activity',
        table_class: 'table-responsive table--row-borders table--darkhead',
        table_desc: 'This table shows user login activity.',

        dataset: activities,
        columns: [
            {
                title: 'Time',
                source: 'loggedAt',
                source_type: 'datetime',
                dateFormat: 'd/m/Y H:i:s',
                path: path,
                path_params: path_params,
            },
            {
                title: 'User',
                source: 'username',
            },
            {
                title: 'Type',
                badges: [
                    {
                        label: 'type.label',
                        varClassName: 'type.className',
                    }
                ],
            },
            {
                title: 'IP',
                source: 'ipAddress',
            },
            {
                title: 'User-agent',
                source: 'userAgent',
                className: 'text-muted small',
                maxLength: 70,
            },
        ],
        filter_values: query.filters|default([]),
        rowHighlighting: [
            {
                className: 'table-danger',
                field: 'type.value',
                equals: 'failure'
            }
        ],
        slug_prefix: 'admin/trusted_devices',

        show_pagination: false,
        show_search: show_search,
        show_select_deselect: false,
        view_setting: 'table',
        zebra: true,
    } %}
</div>
{% endblock content %}
