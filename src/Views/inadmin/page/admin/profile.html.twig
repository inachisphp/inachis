{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incc_admin_list') }}">Users</a>
    <span>Edit User</span>
{% endblock pagetitle %}

{% block content %}
{{ form_start(form, {'attr': { 'class': 'col-12 form form__post form__user' }}) }}

{% if user.username is defined and user.username is not empty %}
    {{ include('inadmin/partials/tab-sets/profile.html.twig', {
        'activeTab': 'profile'
    }) }}
{% endif %}
<fieldset class="ui-section" id="user__profile">
    <legend>Personal Information</legend>
    {% if user.id is not defined or user.id is empty %}
    <p>
        {{ form_label(form.username) }}
        {{ form_widget(form.username) }}
        {{ form_errors(form.username) }}
    </p>
    {% endif %}

    <p>
    {{ form_label(form.displayName) }}
    {{ form_widget(form.displayName) }}
    {{ form_errors(form.displayName) }}
    </p>

    <p>
    {{ form_label(form.email) }}
    {{ form_widget(form.email) }}
    {{ form_errors(form.email) }}
    </p>

    <p>
    {{ form_label(form.timezone) }}
    {{ form_widget(form.timezone) }}
    {{ form_errors(form.timezone) }}
    </p>

    {% if app.user.username == user.username %}
    <p>
        {{ form_label(form.color) }}
        {{ form_widget(form.color) }}
        {{ form_errors(form.color) }}
    </p>
    {% endif %}
</fieldset>

{% if form.assignedRoles is defined %}
<fieldset class="ui-section" id="user__roles">
    <legend>
        {{ form_label(form.assignedRoles) }}
    </legend>
    {{ form_errors(form.assignedRoles) }}

    {% for child in form.assignedRoles %}
        {% set role = form.assignedRoles.vars.choices[loop.index0].data %}

        <label for="{{ child.vars.id }}" class="role-card {% if child.vars.checked %}is-selected{% endif %}">
            <div class="role-card-checkbox">
                {{ form_widget(child) }}
            </div>

            <div class="role-card-content">
                <span class="role-title">{{ role.name }}</span>
                {% if role.description %}
                    <p class="role-description">
                        {{ role.description }}
                    </p>
                {% endif %}
            </div>
        </label>
    {% endfor %}
</fieldset>
{% endif %}

{% if true %}
<fieldset class="ui-section" id="user__auth">
    {% if not user.isTotpEnabled %}
        <p>
            {{ form_widget(form.enableTotp) }}
        </p>
    {% else %}
    <section class="admonition admonition__tip">
        <header class="admonition__title">
            <span class="material-icons">verified_user</span>
            <span>Two-Factor Authentication is enabled</span>
        </header>
        <p>Enabled on <strong>{{ user.totp.enabledAt|date('l jS F Y \\a\\t H:i', viewModel.session.preferences.timezone) }}</strong></p>
    </section>
    <p>
         {{ form_widget(form.disableTotp) }}
    </p>
    <section class="admonition {% if remainingRecoveryCodes >= 4 %}admonition__tip{% elseif remainingRecoveryCodes >= 1 %}admonition__warning{% else %}admonition__danger{% endif %}">
        <header class="admonition__title">Recovery Codes</header>
        <p>Remaining: <strong>{{ remainingRecoveryCodes }}</strong></p>
        <p>Recovery codes can be used once if you lose access to your authenticator.</p>
        <p>{{ form_widget(form.regenerateCodes) }}</p>
    {% endif %}
</fieldset>
{% endif %}

<div class="fixed-bottom-bar">
    <p>
        {{ form_widget(form.submit) }}
        {% if user.id is not empty and app.user.username != user.username %}
            {{ form_widget(form.enableDisable) }}
            {{ form_widget(form.delete) }}
        {% endif %}
    </p>
</div>

{{ form_end(form) }}
{% endblock content %}
