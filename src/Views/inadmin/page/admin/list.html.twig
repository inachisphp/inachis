{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>Users</span>
{% endblock pagetitle %}

{% block content %}
    <div class="col-12">
        {% include 'inadmin/partials/tab-sets/users.html.twig' %}

        {% include 'inadmin/partials/components/view_content.html.twig' with {
            className: 'form__users',
            type: 'users',

            table_name: 'Administrator list',
            table_class: 'table-responsive table--row-borders table--darkhead',
            table_desc: 'This table lists administrators. The first column contains checkboxes allowing users to select one or more tasks.',
            columns: [
                {
                    title: 'Display Name',
                    slug: 'username',
                    source: 'displayName',
                    header: true,
                },
                {
                    title: 'Username',
                    source: 'username',
                },
                {
                    title: 'Roles',
                    source: 'assignedRoles',
                    source_type: 'object',
                    object_field: 'name',
                },
                {
                    title: 'Status',
                    flex: true,
                    badges: {
                        'disabled': {
                            field: 'enabled',
                            condition: false,
                            className: 'badge__disabled',
                        },
                        'new-user': {
                            field: 'password',
                            condition: '',
                            className: 'badge__newuser',
                        },
                        'active': {
                            default: true,
                            className: 'badge__active',
                        }
                    },
                },
                {
                    title: '2FA Status',
                    badges: {
                        '2FA': {
                            field: 'isTotpEnabled',
                            condition: true,
                            className: 'badge__active',
                        },
                        'n/a': {
                            default: true,
                        }

                    }
                },
                {
                    title: 'Last Login',
                    source: 'lastLoginAt',
                    source_type: 'date',
                    hideOnMobile: true,
                },
                {
                    title: 'Password Modified',
                    source: 'passwordChangedAt',
                    source_type: 'date',
                    hideOnMobile: true,
                },
            ],

            offset: query.offset,
            limit: query.limit,
            total: dataset.count,

            slug_prefix: 'admin',

            'filters': {
                'Status': {
                    '': 'All',
                    'enabled': 'Enabled',
                    'disabled': 'Disabled',
                },
                'Role': { '': 'All'}|merge(roles),
                'Last Sign-in': {
                    '': 'All',
                    '30': 'Over 30 days',
                    '90': 'Over 90 days',
                    '180': 'Over 180 days',
                    '365': 'Over 365 days',
                },
                'Password Modified': {
                    '': 'All',
                    '30': 'Over 30 days',
                    '90': 'Over 90 days',
                    '180': 'Over 180 days',
                    '365': 'Over 365 days',
                },
                '2FA Status': {
                    '': 'All',
                    'enabled': 'Enabled',
                    'disabled': 'Disabled',
                },
            },
            filter_values: query.filters,
            show_search: true,
            search_placeholder: 'Search users…',
            show_select_deselect: can('USER', ['EDIT', 'DELETE']),
            sort_options: {
                'createdAt desc': 'Created: Newest',
                'createdAt asc': 'Created: Oldest',
                'updatedAt desc': 'Modified: Newest',
                'updatedAt asc': 'Modified: Oldest',
                'displayName desc': 'Name: Z-A',
                'displayName asc': 'Name: A-Z',
                'username asc': 'Username: A-Z',
                'username desc': 'Username: Z-A',
            },

            add_button: can('USER', 'CREATE') ? {
                image: 'person_add',
                text: 'Create Admin',
                url: path('incp_admin_edit', { id: 'new' }),
            } : null,

            url_result: path('incp_admin_list'),
            zebra: true,

            actions: {
                enable: can('USER', 'EDIT') ? {
                    button_class: 'button--secondary',
                    'data': {
                        'form-action': '',
                    },
                    icon: 'person_outline',
                    title: 'admin.button.enable'|trans,
                } : null,
                disable: can('USER', 'EDIT') ? {
                    button_class: 'button--secondary',
                    'data': {
                        'form-action': '',
                    },
                    icon: 'person_off',
                    title: 'admin.button.disable'|trans,
                } : null,
                delete: can('USER', 'DELETE') ? {
                    button_class: 'button--negative button--delete button--confirm',
                    'data': {
                        'confirm': 'delete',
                        'confirm-text': 'Yes, delete',
                        'entity': 'users',
                        'form-action': '',
                        'title': 'Delete selected users',
                        'warning': 'All currently selected users will be deleted permanently, and they will lose access to this system. This action cannot be undone.',
                    },
                    icon: 'delete',
                    name: 'delete',
                    value: '1',
                    title: 'Delete',
                } : null,
            }|filter(v => v is not null),
            view_setting: 'table',

        } %}
    </div>
{% endblock content %}
