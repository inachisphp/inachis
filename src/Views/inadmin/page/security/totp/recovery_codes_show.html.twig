{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incc_admin_list') }}">Users</a>
    <span>Recovery Codes</span>
{% endblock pagetitle %}

{% block content %}
<article class="col-12 ui-section">
    <section class="admonition admonition__warning">
        <header class="admonition__title">Important</header>
        <p>These recovery codes will only be shown once.
        Store them somewhere safe such as a password manager or print them.
        Each code can only be used once.</p>
    </section>

    <div class="card">
    {% for code in codes %}
        <p>
            <code>{{ code }}</code>
        </p>
    {% endfor %}
    </div>
    <p>
        <button
            class="button button--secondary"
            onclick="window.print()">
            Print Codes
        </button>

        <a
            href="{{ path('incc_admin_edit', {'id': viewModel.session.username }) }}"
            class="button button--positive">
            I've Saved These Codes
        </a>
    </p>
</article>
{% endblock content %}