{% extends "inadmin/partials/form_account.html.twig" %}
{% set page_type = 'login' %}
{% set page_title = 'Login to' %}

{% block form_account %}
<h2>Two-factor authentication</h2>
<p>
    Enter the six-digit code from your
    authenticator application.
</p>

<p>
    {{ form_label(form.code) }}
    {{ form_widget(form.code) }}
    {{ form_errors(form.code) }}
</p>

<p>{{ form_widget(form.verify) }}</p>
<p><a href="{{ path('inadmin_recovery_code_login') }}">Can't access your authenticator? Use a recovery code</a></p>

{% endblock form_account %}
