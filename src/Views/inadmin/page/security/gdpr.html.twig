{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>Privacy &amp; GDPR Management</span>
{% endblock pagetitle %}

{% block content %}
<div class="col-12">
    <form method="post" action="{{ path('incc_security_privacy_save') }}">
        
        {# --- SECTION 1: COOKIE CONSENT BANNER --- #}
        <section class="ui-section widget rounded mb-4 p-4">
            <header class="widget__header border-bottom pb-2 mb-3 d-flex align-items-center">
                <span class="material-icons me-2 text-primary" aria-hidden="true">cookie</span>
                <h2 class="h5 m-0">Cookie Consent Banner</h2>
            </header>
            <article class="row g-3">
                <div class="col-12 col-md-6">
                    <label for="gdpr_banner_enabled" class="form-label font-weight-bold">Enable Consent Banner</label>
                    <select id="gdpr_banner_enabled" name="gdpr[banner_enabled]" class="form-control" {% if not can('PRIVACY_GDPR', 'EDIT') %}disabled{% endif %}>
                        <option value="1" {% if privacy.banner_enabled == '1' %}selected{% endif %}>Enabled (Show to Visitors)</option>
                        <option value="0" {% if privacy.banner_enabled == '0' %}selected{% endif %}>Disabled</option>
                    </select>
                    <small class="text-muted">Displays a consent banner to EU/UK visitors prior to setting non-essential cookies.</small>
                </div>

                <div class="col-12 col-md-6">
                    <label for="gdpr_consent_mode" class="form-label font-weight-bold">Consent Enforcement Mode</label>
                    <select id="gdpr_consent_mode" name="gdpr[consent_mode]" class="form-control" {% if not can('PRIVACY_GDPR', 'EDIT') %}disabled{% endif %}>
                        <option value="opt_in" {% if privacy.consent_mode == 'opt_in' %}selected{% endif %}>Strict Opt-In (Block scripts until accepted)</option>
                        <option value="opt_out" {% if privacy.consent_mode == 'opt_out' %}selected{% endif %}>Opt-Out (Notice only / Implicit)</option>
                    </select>
                    <small class="text-muted">Strict Opt-In is required for strict ePrivacy / GDPR compliance.</small>
                </div>

                <div class="col-12 mt-3">
                    <label for="gdpr_banner_message" class="form-label font-weight-bold">Banner Message Text</label>
                    <textarea id="gdpr_banner_message" name="gdpr[banner_message]" class="form-control" rows="3" {% if not can('PRIVACY_GDPR', 'EDIT') %}readonly{% endif %}>{{ privacy.banner_message|default('We use cookies to improve your browsing experience and analyze site traffic.') }}</textarea>
                </div>
            </article>
        </section>

        {# --- SECTION 2: IP ANONYMIZATION & DATA RETENTION --- #}
        <section class="ui-section widget rounded mb-4 p-4">
            <header class="widget__header border-bottom pb-2 mb-3 d-flex align-items-center">
                <span class="material-icons me-2 text-primary" aria-hidden="true">visibility_off</span>
                <h2 class="h5 m-0">IP Anonymization &amp; Logging</h2>
            </header>
            <article class="row g-3">
                <div class="col-12 col-md-6">
                    <label for="gdpr_anonymize_ips" class="form-label font-weight-bold">Anonymize IP Addresses</label>
                    <select id="gdpr_anonymize_ips" name="gdpr[anonymize_ips]" class="form-control" {% if not can('PRIVACY_GDPR', 'EDIT') %}disabled{% endif %}>
                        <option value="1" {% if privacy.anonymize_ips == '1' %}selected{% endif %}>Enabled (Mask last octet e.g., 192.168.1.xxx)</option>
                        <option value="0" {% if privacy.anonymize_ips == '0' %}selected{% endif %}>Disabled (Log Full IPs)</option>
                    </select>
                    <small class="text-muted">Applies to internal analytics, audit logs, and access logs.</small>
                </div>

                <div class="col-12 col-md-6">
                    <label for="gdpr_log_retention_days" class="form-label font-weight-bold">Log Data Retention (Days)</label>
                    <input type="number" id="gdpr_log_retention_days" name="gdpr[log_retention_days]" class="form-control" value="{{ privacy.log_retention_days|default(90) }}" min="7" max="730" {% if not can('PRIVACY_GDPR', 'EDIT') %}readonly{% endif %}>
                    <small class="text-muted">Automatically purge analytics &amp; access logs older than this threshold.</small>
                </div>
            </article>
        </section>

        {# --- SECTION 3: USER DATA EXPORTS (SAR / ERASURE) --- #}
        <section class="ui-section widget rounded mb-4 p-4">
            <header class="widget__header border-bottom pb-2 mb-3 d-flex align-items-center">
                <span class="material-icons me-2 text-primary" aria-hidden="true">download_for_offline</span>
                <h2 class="h5 m-0">User Data Requests (SAR / Erasure)</h2>
            </header>
            <article>
                <p class="text-muted mb-3">Execute Subject Access Requests (SAR) or process "Right to be Forgotten" account deletions for specific users.</p>
                
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6">
                        <label for="sar_user_email" class="form-label font-weight-bold">Target User Email / Username</label>
                        <input type="text" id="sar_user_email" name="user_identifier" class="form-control" placeholder="user@example.com">
                    </div>
                    <div class="col-12 col-md-6 d-flex gap-2">
                        {# Data Export Action #}
                        <form method="post" action="{{ path('incc_security_privacy_export_user') }}" style="display:inline;">
                            <input type="hidden" name="user_identifier" class="js-target-user-input">
                            <button type="submit" class="button button--secondary">
                                <span class="material-icons" aria-hidden="true">download</span> Export Personal Data
                            </button>
                        </form>

                        {# User Anonymization Action #}
                        {% if can('PRIVACY_GDPR', 'DELETE') %}
                        <form method="post" action="{{ path('incc_security_privacy_anonymize_user') }}" style="display:inline;" onsubmit="return confirm('Are you sure you want to permanently anonymize this user?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('anonymize_user') }}">
                            <input type="hidden" name="user_identifier" class="js-target-user-input">
                            <button type="submit" class="button button--negative">
                                <span class="material-icons" aria-hidden="true">delete</span> Anonymize User
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </div>
            </article>
        </section>

        {# Quick JS helper to pass target user string into hidden form inputs #}
        <script>
        document.getElementById('sar_user_email')?.addEventListener('input', function(e) {
            document.querySelectorAll('.js-target-user-input').forEach(input => {
                input.value = e.target.value;
            });
        });
        </script>

        {# --- FORM ACTIONS --- #}
        {% if can('PRIVACY_GDPR', 'EDIT') %}
        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="button button--primary">
                Save Privacy Settings
            </button>
        </div>
        {% else %}
        <div class="alert alert-info mt-4" role="alert">
            <span class="material-icons" aria-hidden="true">info</span>
            You are viewing these privacy settings in <strong>Read-Only</strong> mode.
        </div>
        {% endif %}

    </form>
</div>
{% endblock content %}