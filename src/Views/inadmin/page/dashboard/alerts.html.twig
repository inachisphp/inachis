<div class="widget widget-alerts">
    {% if false and (dashboard.alerts.altText.count > 0 or dashboard.alerts.categories.count > 0) %}
        <article class="alert_priority__high">
            {% if dashboard.alerts.altText.count > 0 %}
                <p><span>High</span> {{ dashboard.alerts.altText.count }} images without alt text <a href="">Fix &rarr;</a></p>
            {% endif %}
            {% if dashboard.alerts.categories.count > 0 %}
                <p><span>High</span> {{ dashboard.alerts.categories.count }} pages without categories <a href="/incc/post/list?issue=categories">Fix &rarr;</a></p>
            {% endif %}
        </article>
    {% endif %}


</div>