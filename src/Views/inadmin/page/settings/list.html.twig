{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>Settings</span>
{% endblock pagetitle %}

{% block content %}
<div class="col-12 widget-container">

{% if can('NAVIGATION', 'VIEW') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">tab</span></p>
    <h2>Tabs &amp; Navigation</h2>
    <p><span>Manage site navigation and main menu links</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_settings_navigation_list') }}" class="button button--secondary">Manage Tabs</a></p>
</section>
{% endif %}

{% if can('THEME', 'MANAGE') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">format_paint</span></p>
    <h2>Themes &amp; Styling</h2>
    <p><span>Manage and apply visual presentation themes</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_settings_themes') }}" class="button button--secondary">Manage Themes</a></p>
</section>
{% endif %}

{% if can('CRAWLER', 'VIEW') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">android</span></p>
    <h2>Crawlers &amp; Discovery</h2>
    <p><span>Manage robots.txt, llms.txt, and AI engine discovery</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_settings_discovery') }}" class="button button--secondary">Manage Discovery</a></p>
</section>
{% endif %}

{# System Information Widget #}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">info</span></p>
    <h2>System Information</h2>
    <p>
        <span>Version: {{ version.version }}</span><br>
        <span>Commit: {{ version.commit }}</span><br>
    </p>
    <p>
        <small class="text-muted">Build date: {{ version.build_date }}</small>
    </p>
</section>

</div>
{% endblock content %}
