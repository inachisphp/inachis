<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">android</span></p>
    <h2>Crawlers &amp; Discovery</h2>
    <p><span>Manage robots.txt, llms.txt, etc. to help search engines
and AI services</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_settings_discovery') }}" class="button button--secondary">Manage Discovery</a></p>
</section>

<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">commit</span></p>
    <h2>Version {{ version.version }}</h2>
    <p><span>Commit: {{ version.commit }}</span></p>
    <p><span>Build date: {{ version.build_date }}</span></p>
</section>

</div>
{% endblock content %}

