    <p><a href="{{ viewModel.settings.domain }}" class="button button--secondary">Manage Plugins</a></p>
</section>

<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">security</span></p>
    <h2>Security</h2>
