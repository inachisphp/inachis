{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incp_settings_index') }}">
        Settings
    </a>
    <span>Crawlers & Discovery</span>
{% endblock pagetitle %}


{% block content %}
<div class="col-12">
    {% include "/inadmin/partials/tab-sets/discovery.html.twig" %}
<div class="ui-section">
<div class="widget-container">

{% for item in status.documents|merge(status.generated) %}
<section class="widget widget-settings">
    <span class="material-icons" aria-hidden="true">
        {{ item.statusIcon }}
    </span>
    <h2>{{ item.title }}</h2>
    <p><span>{{ item.description }}</span></p>
    {% if item.messages %}
    <div class="widget__alert">
        <p><strong>Status: Issues identified</strong></p>
        <ul>
        {% for message in item.messages %}
            <li>{{ message }}</li>
        {% endfor %}
        </ul>
    </div>
    {% else %}
    <div class="widget__ok">
        <p><strong>Status: OK</strong></p>
    </div>
    {% endif %}
    {% if item.url %}
        <p>
            <a href="{{ viewModel.settings.domain ~ item.url }}"
            class="button button--secondary"
            target="_blank">
                View live
            </a>
        </p>
    {% endif %}
</section>
{% endfor %}

</div>
<p>&nbsp;</p>
</div>
</div>
{% endblock content %}
