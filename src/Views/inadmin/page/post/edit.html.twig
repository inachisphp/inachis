{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incp_post_list', { type: viewModel.page.tab }) }}">{{ viewModel.page.tab|title }}s</a>
    <span>{% if post.id is empty %}New{% else %}Edit{% endif %} {{ viewModel.page.tab }}</span>
{% endblock pagetitle %}

{% block content %}

    {% if post.hasExpired %}
        {% set publishStatus = {
            icon: 'warning',
            label: 'admin.post.expired'|trans,
            help: 'admin.post.expired.help'|trans,
            className: 'warning',
        } %}
    {% elseif post.isScheduledPage %}
        {% set publishStatus = {
            label: 'Scheduled for ' ~ post.postDate|date('l jS F Y \\a\\t H:i', viewModel.session.preferences.timezone),
            className: 'tip'
        } %}
    {% elseif post.status.value == 'review' %}
        {% set publishStatus = { label: 'Under Review', className: 'info' } %}
    {% elseif post.status.value == 'published' %}
        {% if post.visible == true %}
            {% set publishStatus = { label: 'Online', className: 'tip' } %}
        {% else %}
            {% set publishStatus = {
                icon: 'warning',
                label: 'Offline',
                help: 'Change visibility to \'public\' to make this content available',
                className: 'danger',
            } %}
        {% endif %}
    {% endif %}

    {% if publishStatus|default({}) %}
    <div class="col-12 admonition admonition__{{ publishStatus.className }}">
        {% if publishStatus.help|default('') %}
        <header class="admonition__title">
            {% if publishStatus.icon|default(null) %}
            <span class="material-icons" aria-hidden="true">{{ publishStatus.icon }}</span>
            {% endif %}
            <strong>Published Status: </strong> {{ publishStatus.label}}
        </header>
        <p>{{ publishStatus.help }}</p>
        {% else %}
            <strong>Published Status: </strong> {{ publishStatus.label}}
        {% endif %}
    </div>
    {% endif %}

    {% set showStats = post.id is not empty and post.status|default('') == 'published' %}

    {{ form_start(form, {'attr': { 'class': 'col-12 form form__post' }}) }}
    <div class="content__edit">
        <ul class="ui-tabs">
            <li>
                <a href="#post__edit">{% trans %}admin.posts.tabs.content{% endtrans %}</a>
            </li>
            <li>
                <a href="#post__properties">{% trans %}admin.posts.tabs.properties{% endtrans %}</a>
            </li>
            <li>
                <a href="#post__sharing">{% trans %}admin.posts.tabs.sharing{% endtrans %}</a>
            </li>
            {%  if revisions is defined and revisions is not empty %}
            <li>
                <a href="#post__history">{% trans %}admin.posts.tabs.revisions{% endtrans %}</a>
            </li>
            {% endif %}
            {% if showStats %}
            <li data-source="{{ path('incp_api_post_stats', { 'id': post.id }) }}" class="tab--lazyload">
                <a href="#post__stats">{% trans %}admin.posts.tabs.stats{% endtrans %}</a>
            </li>
            {% endif %}
        </ul>

        {{- form_errors(form) -}}

        <fieldset class="ui-section" id="post__edit">
            <legend>{% trans %}admin.post.edit.fieldset{% endtrans %}</legend>
            <p>
                <a class="material-icons ui-toggle" href="#" data-target=".post__link__edit" data-target-state="hidden">link</a>
                {{ form_label(form.title) }}
                {{ form_errors(form.title) }}
                {{ form_widget(form.title) }}
            </p>
            <p>
                {{ form_label(form.subTitle) }}
                {{ form_errors(form.subTitle) }}
                {{ form_widget(form.subTitle) }}
            </p>
            <p class="post__link__edit">
                {{ form_label(form.url) }}
                {{ form_errors(form.url) }}
                {{ viewModel.settings.domain -}}/<input class="field__wide" id="post_url" name="post[url]" type="text" value="{% if post.urls is not empty %}{{ post.urls|first.link }}{% endif %}" />
                {% if post.urls is not empty %}
                <button aria-label="{{ 'admin.post.share.copyLink.help'|trans }}"
                        data-prefix="{{ viewModel.settings.domain }}/"
                        data-target="post_url"
                        class="btn btn--info btn--copy"
                        type="button"
                >
                    <span class="material-icons" aria-hidden="true">content_paste</span>
                    {{ 'admin.post.share.copyLink.label'|trans }}
                </button>
                {% endif %}
            </p>
            <p>
                {{ form_label(form.content) }}
                {{ form_errors(form.content) }}
                {{ form_widget(form.content) }}
            </p>
        </fieldset>

        <fieldset class="ui-section" id="post__properties">
            <legend>{% trans %}admin.post.properties.fieldset{% endtrans %}</legend>
            <p>
                {{ form_label(form.visible) }}
                {{ form_errors(form.visible) }}
                <span class="switch-wrapper">
                    {{ form_widget(form.visible) }}
                </span>
            </p>
            <p>
                {{ form_label(form.showTableOfContents) }}
                {{ form_errors(form.showTableOfContents) }}
                <span class="switch-wrapper">
                    {{ form_widget(form.showTableOfContents) }}
				</span>
            </p>
            <p>
                {{ form_label(form.postDate) }}
                {{ form_errors(form.postDate) }}
                <span id="post__schedule__timed">
                    {{ form_widget(form.postDate) }}
				</span>
            </p>
            <p>
                {{ form_label(form.expireDate) }}
                {{ form_errors(form.expireDate) }}
                <span id="post__schedule__timed">
                    {{ form_widget(form.expireDate) }}
				</span>
            </p>
            <p>
                {{ form_label(form.categories) }}
                {{ form_errors(form.categories) }}
                {{ form_widget(form.categories) }}
                <a href="#" class="material-icons dialog__link"
                        data-dialog="categoryManager"
                >add_box</a>

            </p>
            <p>
                {{ form_label(form.tags) }}
                {{ form_errors(form.tags) }}
                {{ form_widget(form.tags) }}
            </p>
            <p>
                {{ form_label(form.language) }}
                {{ form_errors(form.language) }}
                {{ form_widget(form.language) }}
            </p>
            {% if textStats|default([]) is not empty %}
                <p>{% trans with {'%readingTime%': '<strong>' ~ textStats.readingTime ~ '</strong>'} from 'messages' %}admin.post.properties.readingTime{% endtrans %}</p>
            {% endif %}
            {% if post.imageSize is defined and post.imageSize > 0 %}
                <p><strong>Total size of images used:</strong> {{ post.imageSize }} bytes ({{ (post.imageSize / 1024 / 1024)|round(2) }} Mb)</p>
            {% endif %}
            {% if viewModel.settings.geotagContent is defined and viewModel.settings.geotagContent and viewModel.settings.google.key is defined and viewModel.settings.google.key is not empty %}
            <p>
                {{ form_label(form.latlong) }}
                {{ form_errors(form.latlong) }}
                {{ form_widget(form.latlong) }}
            </p>
            {% endif %}
        </fieldset>

        <fieldset class="ui-section" i id="post__sharing">
            <div class="nested-grid">
                <section class="col-6">
                    <p>
                        {{ form_label(form.featureSnippet) }}
                        {{ form_errors(form.featureSnippet) }}
                        {{ form_widget(form.featureSnippet) }}
                        {% trans %}admin.post.sharing.featureSnippet.help{% endtrans %}
                    </p>
                    {% if aiTextEnabled and form.generate_seo is defined %}
                    <p>
                        {{ form_widget(form.generate_seo) }}
                    </p>
                    {% endif %}
                    <p>
                        {{ form_errors(form.noindex) }}
                        {{ form_widget(form.noindex) }}
                        {{ form_label(form.noindex) }}
                    </p>
                    <p>
                        {{ form_errors(form.nofollow) }}
                        {{ form_widget(form.nofollow) }}
                        {{ form_label(form.nofollow) }}
                    </p>

                    <div id="post_audio_player_wrapper">
                        <!-- If audio already exists, render player on page load -->
                        {% if hasAudio %}
                            <audio controls>
                                <source src="{{ path('web_post_audio_stream', { id: post.id }) }}" type="audio/mpeg">
                            </audio>
                        {% endif %}
                    </div>
                    {% if not hasAudio %}
                    <p>
                        <button
                            type="button"
                            id="post_generate_audio"
                            class="btn btn--ai"
                            data-post-id="{{ post.id }}"
                        >
                            <span class="material-icons">graphic_eq</span> Generate Audio Version
                        </button>
                    </p>
                    {% endif %}
                </section>
                <section class="col-6">
                {{
                    include('inadmin/partials/image_preview.html.twig', {
                        'id': 'featureImage',
                        'name': 'post[featureImage]',
                        'value': post.featureImage
                    })
                }}
                </section>
            </div>
        </fieldset>

        {%  if revisions is defined and revisions is not empty %}
        <fieldset class="ui-section" i id="post__history">
            {% if post.id is not empty %}
            <p>
                {{ form_label(form.updatedAt) }}
                {{ form_errors(form.updatedAt) }}
                {{ form_widget(form.updatedAt) }}
            </p>
            {% endif %}
            <table class="table table-responsive table-striped table-borderless">
                <caption>{% trans %}admin.post.revision.caption{% endtrans %}</caption>
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">{% trans %}admin.post.revision.date{% endtrans %}</th>
                        <th scope="col">{% trans %}admin.post.revision.author{% endtrans %}</th>
                        <th scope="col">{% trans %}admin.post.revision.changes{% endtrans %}</th>
                        <th scope="col">&nbsp;</th>
                    </tr>
                </thead>
                <tbody>
                {% for revision in revisions %}
                    <tr>
                        <th scope="row">{{ revision.versionNumber }}</th>
                        <td>{{ revision.createdAt|date('d/m/Y H:i', viewModel.session.preferences.timezone) }}</td>
                        <td>{{ revision.user.displayName }}</td>
                        <td><span class="badge">{{ revision.action }}</span></td>
                        <td>
                            <a href="{{ path('inachis_page_post_revision_diff', { 'id': revision.id}) }}" class="btn btn--info"><span class="material-icons" aria-hidden="true">compare_arrows</span> {% trans %}admin.post.revision.view{% endtrans %}</a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </fieldset>
        {% endif %}

        {% if showStats %}
        <fieldset class="ui-section" id="post__stats">
        </fieldset>
        {% endif %}
    </div>

    {% set previewMode = post.postDate > date() %}
    <div class="fixed-bottom-bar">
        <p>
            {% if form.submit is defined %}{{ form_widget(form.submit) }}{% endif %}

        {% if post.id is not empty %}
            {% if form.review is defined %}{{ form_widget(form.review) }}{% endif %}
            {% if form.publish is defined %}{{ form_widget(form.publish) }}{% endif %}
            {%  if not post.isDraft %}
                <a class="btn btn--secondary" href="{% if previewMode %}/incp/preview{% endif %}/{{ post.urls|first.link }}" target="_blank" title="{% trans %}admin.button.viewLive{% endtrans %}">
                    <span class="material-icons" aria-hidden="true">exit_to_app</span>
                    <span class="btn-text">{% trans %}admin.button.viewLive{% endtrans %}</span></a>
            {%  endif %}
            {% if form.delete is defined %}{{ form_widget(form.delete) }}{% endif %}
        {% endif %}
        </p>
    </div>
    {{ form_row(form._token) }}
    {{ form_end(form, { 'render_rest': false }) }}

{% endblock content %}


{% block reviewbar %}
    {% if post.status.value == 'review' %}
    <div id="review-sidebar-container"></div>
    {% endif %}
{% endblock reviewbar %}