{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>{{ viewModel.page.tab|title }}s</span>
{% endblock pagetitle %}

{% block content %}

    {% set badges = {
        draft: {
            field: 'isdraft',
            condition: 'true',
            className: 'badge__draft',
        },
        expired: {
            field: 'hasExpired',
            condition: true,
            className: 'badge__critical',
        },
        scheduled: {
            field: 'isScheduledPage',
            condition: true,
            className: 'badge__scheduled',
        },
        private: {
            field: 'isVisible',
            condition: false,
            className: 'badge__private',
        },
        issue: {
            context: 'slug_object',
            condition: '',
            className: 'badge__issue',
        },

    } %}
    {% if app.request.server.get('WARN_HOTLINKED_IMAGES_ENABLED')|default('0') == '1' %}
        {% set badges = badges|merge({
            'hot-linked-images': {
                'field': 'hasHotlinkedImages',
                'condition': true,
                'className': 'badge__hotlink'
            }
        }) %}
    {% endif %}

    {% set link_new = path('incc_post_edit', {'type': 'post'}) ~ '/post/new' %}
    {% if viewModel.page.tab == 'page' %}
        {% set link_new = path('incc_post_edit', {'type': 'page'}) ~ '/new' %}
    {% endif %}

<div class="col-12">
    {% include 'inadmin/partials/tab-sets/posts.html.twig' %}
    {% include 'inadmin/partials/components/view_content.html.twig' with {
        className: 'form__posts',
        type: 'post',
        dataset: posts,

        offset: query.offset,
        limit: query.limit,
        total: posts.count,

        snippet_description: 'content',
        slug_prefix: viewModel.page.tab,
        slug: 'urls[0].link',

        add_button: {
            image: 'note_add',
            text: 'Create ' ~ viewModel.page.tab|capitalize,
            url: link_new,
        },
        url_result: path('incc_post_list'),

        badges: badges,

        actions: {
            private: {
                button_class: 'button--secondary button--privacy',
                data: {
                    'form-action': ''
                },
                icon: 'visibility_off',
                title: 'Make private',
            },
            public: {
                button_class: 'button--secondary button--privacy',
                data: {
                    'form-action': ''
                },
                icon: 'visibility',
                title: 'Make public',
            },
            rebuild: {
                button_class: 'button--secondary',
                data: {
                    'form-action': ''
                },
                'icon': 'hub',
                title: 'Recreate Link'
            },
            export: {
                button_class: 'button--secondary button--export',
                button_type: 'button',
                data: {
                    'content-type': 'post',
                    'form-action': path('incc_tools_export'),
                    'scope': 'manual',
                },
                icon: 'cloud_download',
                'title': 'Export',
            },
            delete: {
                button_class: 'button--negative button--delete button--confirm',
                data: {
                    confirm: 'delete',
                    'confirm-text': 'Yes, delete',
                    entity: 'posts',
                    'form-action': '',
                    title: 'Delete selected  ' ~ viewModel.page.tab ~ 's',
                    warning: 'All currently selected content will be deleted permanently. This action cannot be undone.',
                },
                icon: 'delete_forever',
                'name': 'delete',
                'value': '1',
                'title': 'Delete',
            }
        },

        columns: [
            {
                title: 'Title',
                source: 'title',
                slug: 'urls[0].link',
            },
            {
                title: 'Sub-title',
                source: 'subTitle',
            },
            {
                title: 'Post Date',
                source: 'postDate',
                source_type: 'date',
            },
            {
                title: 'Status',
                flex: true,
                badges: badges,
            }
        ],

        filters: {
            Status: {
                '': 'All',
                'draft': 'Draft',
                'review': 'In Review',
                'published': 'Published',
            },
            Visibility: {
                '': 'All',
                '0': 'Private',
                '1': 'Public',
            },
            Expired: {
                '': 'All',
                'expired': 'Expired',
            },
        },

        filter_values: query.filters,

        sort_options: {
            'postDate asc': 'Published: Oldest',
            'postDate desc': 'Published: Newest',
            'updatedAt asc': 'Modified: Oldest',
            'updatedAt desc': 'Modified: Newest',
            'title asc': 'Title: A-Z',
            'title desc': 'Title: Z-A',
        },

        show_category_filter: true,
        show_select_deselect: true,
        show_search: true,
        search_placeholder: 'Search posts…',
        showSummary: true,
        view_modes: [ 'list', 'table' ],
        view_setting: query.view|default('list'),
        zebra: true,
    }
    %}

</div>

{% endblock content %}