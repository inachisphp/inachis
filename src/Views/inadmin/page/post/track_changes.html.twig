{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incp_post_list', { type: viewModel.page.tab }) }}">{{ viewModel.page.tab|title }}s</a>
    <a href="/incp/{{ viewModel.page.tab }}/{{ url }}">Edit {{ viewModel.page.tab }}</a>
    <span>Track Changes</span>
{% endblock pagetitle %}

{% block content %}
    <section class="col-12" id="track_changes">
        <h2>{% if title[0][0].tag is defined %}{{ title[0][0].new.lines[0]|raw }}{% else %}{{ title }}{% endif %}</h2>
    {% if subTitle is not empty %}
        <h3>{% if subTitle[0][0].tag is defined %}{{ subTitle[0][0].new.lines[0]|raw }}{% else %}{{ subTitle }}{% endif %}</h3>
    {% endif %}
    {% for block in content %}
        {% if block.type == enum(diffBlockType).UNCHANGED %}
            {{ block.html|markdown_to_html }}

        {% elseif block.type == enum(diffBlockType).DELETED %}
            <del class="revision-diff__deleted">
                {{ block.html|markdown_to_html }}
            </del>

        {% elseif block.type == enum(diffBlockType).REPLACED %}
            <div class="revision-diff__changed">
                {{ block.html|markdown_to_html }}
            </div>
        {% endif %}
    {% endfor %}

    </section>
    <p>&nbsp;</p>
    <p>&nbsp;</p>

    <div class="fixed-bottom-bar">
        <form method="post">
            <p>
            {% if can('PAGE', 'EDIT') %}
                <button class="btn btn--danger btn--delete btn--confirm"
                    data-confirm="revert"
                    data-confirm-text="Yes, revert"
                    data-entity="post"
                    data-form-action=""
                    data-title="Revert selected  {{ viewModel.page.tab }}"
                    data-warning="Your current version will be replaced with the contents of this previous state."
                    name="doRevert" type="submit">
                    <span class="material-icons" aria-hidden="true">undo</span> <span>Revert</span>
                </button>
            {% endif %}
                <a href="{{ path('incp_post_download', { 'id': revision_id }) }}" class="btn btn--secondary">
                    <span class="material-icons" aria-hidden="true">save_alt</span> {% trans %}admin.post.revision.download{% endtrans %}
                </a>
                <a href="/incp/post/{{ url }}" class="btn btn--info">
                    <span>Cancel</span>
                </a>
            </p>
        </form>
    </div>
{% endblock content %}
