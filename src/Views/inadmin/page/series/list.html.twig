{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>Series</span>
{% endblock pagetitle %}

{% set badges = {
    'private': {
        'field': 'visible',
        'condition': false,
        'className': 'badge__private'
    },
} %}

{% block content %}
<div class="col-12">
    {% include 'inadmin/partials/components/view_content.html.twig' with {
        'className': 'form__series',
        'type': 'series',

        'offset': query.offset,
        'limit': query.limit,
        'total': dataset.count,

        'snippet_description': 'description',
        'slug_prefix': 'series/edit',
        'slug': 'id',

        'add_button': {
            image: 'create_new_folder',
            'text': 'Create Series',
            'url': path('incc_series_new'),
        },
        'url_result': path('incc_series_list'),

        'filters': {
            'Visibility': {
                '': 'All',
                'private': 'Private',
                'public': 'Public',
            }
        },
        'filter_values': query.filters,
        'show_select_deselect': true,
        show_search: true,
        search_placeholder: 'Search series…',
        showSummary: true,
        zebra: true,

        'actions': {
            'private': {
                'button_class': 'button--secondary button--privacy',
                'data': {
                    'form-action': ''
                },
                'icon': 'visibility_off',
                'title': 'Make private',
            },
            'public': {
                'button_class': 'button--secondary button--privacy',
                'data': {
                    'form-action': ''
                },
                'icon': 'visibility',
                'title': 'Make public',
            },
            'export': {
                'button_class': 'button--secondary button--export',
                'button_type': 'button',
                'data': {
                    'content-type': 'series',
                    'form-action': path('incc_tools_export'),
                    'scope': 'manual',
                },
                'icon': 'cloud_download',
                'title': 'Export',
            },
            'delete': {
                'button_class': 'button--negative button--delete button--confirm',
                'data': {
                    'confirm': 'delete',
                    'confirm-text': 'Yes, delete',
                    'entity': 'series',
                    'form-action': '',
                    'title': 'Delete selected series',
                    'warning': 'All currently selected content will be deleted permanently. This action cannot be undone.',
                },
                'icon': 'delete_forever',
                'name': 'delete',
                'value': '1',
                'title': 'Delete',
            },
        },

        'sort_options': {
            'lastDate desc': 'Newest',
            'lastDate asc': 'Oldest',
            'updatedAt desc': 'Modfied: Newest',
            'updatedAt asc': 'Modfiied: Oldest',
            'title asc': 'Title: A-Z',
            'title desc': 'Title: Z-A',
        },

        'badges': badges,


        columns: [
            {
                title: 'Title',
                source: 'title',
                slug: 'id',
            },
            {
                title: 'Sub-title',
                source: 'subTitle',
            },
            {
                title: 'First Date',
                source: 'firstDate',
                source_type: 'date',
            },
            {
                title: 'Last Date',
                source: 'lastDate',
                source_type: 'date',
            },
            {
                title: 'Status',
                flex: true,
                badges: badges,
            }
        ],

        view_modes: [ 'list', 'table' ],
        view_setting: query.view|default('list'),
    }
%}
</div>

{% endblock content %}
