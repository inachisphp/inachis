{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>Tools</span>
{% endblock pagetitle %}

{% block content %}
<div class="col-12 widget-container">

{% if canResource('ANALYTICS') %}
<section class="widget widget-settings">
    <a href="{{ viewModel.settings.domain ~ path('incp_tools_analytics') }}" class="widget-settings__link">
        <div class="widget-settings__icon">
            <span class="material-icons" aria-hidden="true">analytics</span>
        </div>
        <h2>Analytics</h2>
        <p class="widget-settings__desc">Review traffic trends, popular content, and visitor metrics.</p>
        <div class="widget-settings__action">
            <span class="btn btn--secondary">View Analytics</span>
        </div>
    </a>
</section>
{% endif %}

{% if canResource('STORAGE') %}
<section class="widget widget-settings">
    <a href="{{ viewModel.settings.domain ~ path('incp_tools_storage') }}" class="widget-settings__link">
        <div class="widget-settings__icon">
            <span class="material-icons" aria-hidden="true">sd_storage</span>
        </div>
        <h2>Storage</h2>
        <p class="widget-settings__desc">Inspect disk usage, media upload limits, and temporary assets.</p>
        <div class="widget-settings__action">
            <span class="btn btn--secondary">Check Storage</span>
        </div>
    </a>
</section>
{% endif %}

{% if environment !== 'prod' and canResource('ERROR_LOG') %}
<section class="widget widget-settings">
    <a href="{{ viewModel.settings.domain ~ path('incp_tools_logs') }}" class="widget-settings__link">
        <div class="widget-settings__icon">
            <span class="material-icons" aria-hidden="true">article</span>
        </div>
        <h2>Logs</h2>
        <p class="widget-settings__desc">Review recent application, environment, and system error logs.</p>
        <div class="widget-settings__action">
            <span class="btn btn--secondary">View Logs</span>
        </div>
    </a>
</section>
{% endif %}

{% if canResource('IMPORT_EXPORT') %}
<section class="widget widget-settings">
    <a href="{{ viewModel.settings.domain ~ path('incp_tools_import') }}" class="widget-settings__link">
        <div class="widget-settings__icon">
            <span class="material-icons" aria-hidden="true">import_export</span>
        </div>
        <h2>Import &amp; Export</h2>
        <p class="widget-settings__desc">Export site content or import backup packages and media.</p>
        <div class="widget-settings__action">
            <span class="btn btn--secondary">Import / Export</span>
        </div>
    </a>
</section>
{% endif %}

{% if canResource('MAINTENANCE') %}
<section class="widget widget-settings">
    <a href="{{ viewModel.settings.domain ~ path('incp_tools_maintenance') }}" class="widget-settings__link">
        <div class="widget-settings__icon">
            <span class="material-icons" aria-hidden="true">construction</span>
        </div>
        <h2>Maintenance Mode</h2>
        <p class="widget-settings__desc">Toggle maintenance mode and manage public access notices.</p>
        <div class="widget-settings__action">
            <span class="btn btn--secondary">Manage Mode</span>
        </div>
    </a>
</section>
{% endif %}

{% if true %}
<section class="widget widget-settings widget-settings--danger">
    <a href="{{ viewModel.settings.domain }}" class="widget-settings__link">
        <div class="widget-settings__icon">
            <span class="material-icons" aria-hidden="true">delete_forever</span>
        </div>
        <h2>Data Purge</h2>
        <p class="widget-settings__desc"><strong>Danger:</strong> Permanently wipe content and reset site data.</p>
        <div class="widget-settings__action">
            <span class="btn btn--danger">Purge Data</span>
        </div>
    </a>
</section>
{% endif %}

</div>
{% endblock content %}