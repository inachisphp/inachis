{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>Tools</span>
{% endblock pagetitle %}

{% block content %}
<div class="col-12 widget-container">

{% if canResource('ANALYTICS') %}
    {% include 'inadmin/partials/components/card.html.twig' with {
        title: 'Analytics',
        icon: 'analytics',
        description: 'Review traffic trends, popular content, and visitor metrics.',
        button_text: 'View Analytics',
        link: viewModel.settings.domain ~ path('incp_tools_analytics'),
    } %}
{% endif %}

{% if canResource('STORAGE') %}
    {% include 'inadmin/partials/components/card.html.twig' with {
        title: 'Storage',
        icon: 'sd_storage',
        description: 'Inspect disk usage, media upload limits, and temporary assets.',
        button_text: 'Check Storage',
        link: viewModel.settings.domain ~ path('incp_tools_storage'),
    } %}
{% endif %}

{% if environment !== 'prod' and canResource('ERROR_LOG') %}
    {% include 'inadmin/partials/components/card.html.twig' with {
        title: 'Logs',
        icon: 'article',
        description: 'Review recent application, environment, and system error logs.',
        button_text: 'View Logs',
        link: viewModel.settings.domain ~ path('incp_tools_logs'),
    } %}
{% endif %}

{% if canResource('IMPORT_EXPORT') %}
    {% include 'inadmin/partials/components/card.html.twig' with {
        title: 'Import & Export',
        icon: 'import_export',
        description: 'Export site content or import backup packages and media.',
        button_text: 'Import / Export',
        link: viewModel.settings.domain ~ path('incp_tools_import'),
    } %}
{% endif %}

{% if canResource('MAINTENANCE') %}
    {% include 'inadmin/partials/components/card.html.twig' with {
        title: 'Maintenance Mode',
        icon: 'construction',
        description: 'Toggle maintenance mode and manage public access notices.',
        button_text: 'Manage Mode',
        link: viewModel.settings.domain ~ path('incp_tools_maintenance'),
    } %}
{% endif %}

{% if true %}
    {% embed 'inadmin/partials/components/card.html.twig' with {
        title: 'Data Purge',
        icon: 'delete_forever',
        button_text: 'Purge Data',
        link: viewModel.settings.domain,
        className: 'widget-settings--danger',
    } %}
    {% block description %}
    <strong>Danger:</strong> Permanently wipe content and reset site data.
    {% endblock description %}
    {% endembed %}
{% endif %}

</div>
{% endblock content %}