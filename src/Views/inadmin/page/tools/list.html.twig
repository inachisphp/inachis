{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>Tools</span>
{% endblock pagetitle %}

{% block content %}
{% block settings_pre %}{% endblock settings_pre %}
{% block settings %}
<div class="col-12 widget-container">

{% if canResource('ANALYTICS') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">analytics</span></p>
    <h2>Analytics</h2>
    <p><span>Review traffic trends, popular content, and visitor metrics.</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_tools_analytics') }}" class="button button--secondary">View Analytics</a></p>
</section>
{% endif %}

{% if canResource('STORAGE') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">sd_storage</span></p>
    <h2>Storage</h2>
    <p><span>Inspect disk usage, media upload limits, and temporary assets.</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_tools_storage') }}" class="button button--secondary">Check Storage</a></p>
</section>
{% endif %}

{% if environment !== 'prod' and canResource('ERROR_LOG') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">article</span></p>
    <h2>Logs</h2>
    <p><span>Review recent application, environment, and system error logs.</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_tools_logs') }}" class="button button--secondary">View Logs</a></p>
</section>
{% endif %}

{% if canResource('IMPORT_EXPORT') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">import_export</span></p>
    <h2>Import &amp; Export</h2>
    <p><span>Export site content or import backup packages and media.</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_tools_import') }}" class="button button--secondary">Import / Export</a></p>
</section>
{% endif %}

<!-- section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">backup</span></p>
    <h2>Backup / Restore</h2>
    <p><span>Backup your site and restore from a backup.</span></p>
    <p><a href="{{ viewModel.settings.domain }}" class="button button--secondary">Backup / Restore</a></p>
</section -->

{% if canResource('MAINTENANCE') %}
<section class="widget widget-settings">
    <p><span class="material-icons" aria-hidden="true">construction</span></p>
    <h2>Maintenance Mode</h2>
    <p><span>Toggle maintenance mode and manage public access notices.</span></p>
    <p><a href="{{ viewModel.settings.domain ~ path('incc_tools_maintenance') }}" class="button button--secondary">Manage Mode</a></p>
</section>
{% endif %}

{# add card for cache status / clear #}

{% if true %}
<section class="widget widget-settings widget-settings--danger">
    <p><span class="material-icons" aria-hidden="true">delete_forever</span></p>
    <h2>Data Purge</h2>
    <p><span><strong>Danger:</strong> Permanently wipe content and reset site data.</span></p>
    <p><a href="{{ viewModel.settings.domain }}" class="button button--negative">Purge Data</a></p>
</section>
{% endif %}

</div>
{% endblock settings %}
{% block settings_post %}{% endblock settings_post %}
{% endblock content %}