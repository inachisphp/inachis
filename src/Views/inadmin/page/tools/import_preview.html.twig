{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incp_tools_index') }}">Tools</a>
    <a href="{{ path('incp_tools_import') }}">Import</a>
    <span>Preview</span>
{% endblock pagetitle %}

{% block content %}
<div class="col-12 ui-section">
<section class="paginated-list">
    <p>{{ items|length }} items detected in file. {% if import_type in ['page','series'] %}Imported content will be created with status 'draft'.{% endif %}</p>

    <form class="form nested-grid" method="post" action="{{ path('incp_tools_import_process') }}">
        <table class="table table--responsive table--striped table--compact col-{% if import_type == 'page' %}8{% else %}12{% endif %}">
            <thead>
                <tr>
                {% if import_type == 'page' %}
                    <th>Title</th>
                    <th>Type</th>
                    <th>Categories</th>
                    <th>Tags</th>
                    <th>Post Date</th>
                {% elseif import_type == 'series' %}
                    <th>Title</th>
                    <th>Subtitle</th>
                    <th>Pages</th>
                    <th>Status</th>
                {% elseif import_type == 'category' %}
                    <th>Title</th>
                    <th>Full Path</th>
                {% endif %}
                </tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    {% if import_type == 'page' %}
                        <td>{{ item.title }}</td>
                        <td>{{ item.type }}</td>
                        <td>{{ item.categories|map(c => c.path)|join(', ')|replace({'/': ' > '}) }}</td>
                        <td>{{ item.tags|map(t => t.title)|join(', ') }}</td>
                        <td>{{ item.postDate ? item.postDate|date('Y-m-d H:i', viewModel.session.preferences.timezone) : '' }}</td>
                    {% elseif import_type == 'series' %}
                        <td>{{ item.title }}</td>
                        <td>{{ item.subTitle }}</td>
                        <td>{{ item.items|length }}</td>
                        <td>
                            {% if warnings[loop.index0] is defined %}
                                {% set has_create = warnings[loop.index0]|filter(w => w.type == 'create')|length > 0 %}
                                {% set has_missing = warnings[loop.index0]|filter(w => w.type == 'missing')|length > 0 %}
                                {% set has_error = warnings[loop.index0]|filter(w => w.type == 'error')|length > 0 %}
                                {% if has_error %}
                                    <span class="badge badge__draft">Error</span>
                                {% elseif has_missing %}
                                    <span class="badge badge__draft">Missing pages</span>
                                {% elseif has_create %}
                                    <span class="badge badge__scheduled">Will create</span>
                                {% else %}
                                    <span class="badge badge__published">Ready</span>
                                {% endif %}
                            {% endif %}
                        </td>
                    {% elseif import_type == 'category' %}
                        <td>{{ item.title }}</td>
                        <td>{{ item.fullPath|replace({'/': ' > '}) }}</td>
                    {% endif %}
                </tr>

                {% if import_type == 'series' and warnings[loop.index0] is defined %}
                    <tr class="import-warning-row">
                        <td colspan="4">
                            <ul class="import-warnings">
                                {% for w in warnings[loop.index0] %}
                                    {% if w.type == 'link' %}
                                        <li class="import-status import-status--link">
                                            <span class="material-icons" aria-hidden="true">link</span>
                                            <strong>{{ w.title }}</strong> — exists and will be linked
                                        </li>
                                    {% elseif w.type == 'create' %}
                                        <li class="import-status import-status--create">
                                            <span class="material-icons" aria-hidden="true">add_circle_outline</span>
                                            <strong>{{ w.title }}</strong> — does not exist and will be created
                                        </li>
                                    {% elseif w.type == 'missing' %}
                                        <li class="import-status import-status--missing">
                                            <span class="material-icons" aria-hidden="true">warning</span>
                                            <strong>{{ w.title }}</strong> — does not exist and <em>will not</em> be linked
                                        </li>
                                    {% else %}
                                        <li class="import-status import-status--error">
                                            <span class="material-icons" aria-hidden="true">error_outline</span>
                                            {{ w.title }}
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% elseif import_type != 'series' and warnings[loop.index0] is defined %}
                    <tr class="import-warning-row">
                        <td colspan="{{ import_type == 'page' ? 5 : 5 }}">
                            <ul class="import-warnings">
                                {% for w in warnings[loop.index0] %}
                                    <li>{% if w.title is defined %}{{ w.title }}{% else %}{{ w }}{% endif %}</li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
{% if import_type == 'page' %}
        <fieldset class="col-4">
            <legend>Options</legend>
            <p>Select options for importing the content:</p>
            <p>
                <label>
                    <input type="checkbox" class="checkbox"name="createMissingCategories" value="1" checked>
                    Create missing categories
                </label>
            </p>
            <p>
                <label>
                    <input type="checkbox" class="checkbox" name="createMissingTags" value="1" checked>
                    Create missing tags
                </label>
            </p>
        </fieldset>
{% endif %}
        <div class="fixed-bottom-bar">
            <p>
                <button class="btn btn--primary" type="submit">
                    <span class="material-icons" aria-hidden="true">sync</span>
                    <span class="btn--text">Process Import</span>
                </button>
            </p>
        </div>
    </form>
</section>
</div>
{% endblock content %}
