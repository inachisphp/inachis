{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incp_tools_index') }}">Tools</a>
    <a href="{{ path('incp_tools_import') }}">Import</a>
    <span>Preview</span>
{% endblock pagetitle %}

{% block content %}
{% set col_span = import_type in ['page', 'post'] ? 6 : (import_type == 'series' ? 4 : 2) %}

<div class="col-12 ui-section">
    <section class="paginated-list">
        <header class="preview-header">
            <p>
                <strong>{{ items|length }}</strong> {{ import_type|capitalize }} item(s) detected.
                {% if import_type in ['page', 'post', 'series'] %}
                    Imported content will default to <em>'draft'</em> status.
                {% endif %}
            </p>
        </header>

        <form class="form nested-grid" method="post" action="{{ path('incp_tools_import_process') }}">
        {% if import_type in ['page', 'post'] %}
            <fieldset class="col-12">
                <legend>Import Settings</legend>
                <p>Configure how missing relational dependencies are handled:</p>
                <p>
                    <label>
                        <input type="checkbox" class="checkbox" name="createMissingCategories" value="1" checked>
                        Auto-create missing categories
                    </label>
                </p>
                <p>
                    <label>
                        <input type="checkbox" class="checkbox" name="createMissingTags" value="1" checked>
                        Auto-create missing tags
                    </label>
                </p>
            </fieldset>
        {% endif %}

            <table class="table table--responsive table--striped table--compact col-{% if import_type in ['page', 'post'] %}8{% else %}12{% endif %}">
                <thead>
                    <tr>
                    {% if import_type in ['page', 'post'] %}
                        <th>Title</th>
                        <th>Type</th>
                        <th>Categories</th>
                        <th>Tags</th>
                        <th>Post Date</th>
                        <th>Status</th>
                    {% elseif import_type == 'series' %}
                        <th>Title</th>
                        <th>Subtitle</th>
                        <th>Pages</th>
                        <th>Status</th>
                    {% elseif import_type == 'category' %}
                        <th>Title</th>
                        <th>Full Path</th>
                        <th>Status</th>
                    {% endif %}
                    </tr>
                </thead>
                <tbody>
                {% for item in items %}
                    {% set item_warnings = warnings[loop.index0] ?? [] %}

                    <tr>
                    {% if import_type in ['page', 'post'] %}
                        <td><strong>{{ item.title }}</strong></td>
                        <td><code>{{ item.type }}</code></td>
                        <td>{{ item.categories|map(c => c.path)|join(', ')|replace({'/': ' > '})|default('—') }}</td>
                        <td>{{ item.tags|map(t => t.title)|join(', ')|default('—') }}</td>
                        <td>{{ item.postDate ? item.postDate|date('Y-m-d H:i', viewModel.session.preferences.timezone) : '—' }}</td>
                        <td>
                            {% set has_conflict = item_warnings|filter(w => (w.type is defined and w.type == 'url_exists'))|length > 0 %}
                            {% set has_new = item_warnings|filter(w => (w.type is defined and w.type in ['category_create', 'tag_create', 'url_new']))|length > 0 %}

                            {% if has_conflict %}
                                <span class="badge badge__draft">URL Conflict</span>
                            {% elseif has_new %}
                                <span class="badge badge__scheduled">New Elements</span>
                            {% else %}
                                <span class="badge badge__published">Ready</span>
                            {% endif %}
                        </td>

                    {% elseif import_type == 'series' %}
                        <td><strong>{{ item.title }}</strong></td>
                        <td>{{ item.subTitle|default('—') }}</td>
                        <td>{{ item.items|length }} page(s)</td>
                        <td>
                            {% set has_error = item_warnings|filter(w => w.type is defined and w.type == 'error')|length > 0 %}
                            {% set has_missing = item_warnings|filter(w => w.type is defined and w.type == 'missing')|length > 0 %}
                            {% set has_create = item_warnings|filter(w => w.type is defined and w.type == 'create')|length > 0 %}

                            {% if has_error %}
                                <span class="badge badge__draft">Error</span>
                            {% elseif has_missing %}
                                <span class="badge badge__draft">Missing Pages</span>
                            {% elseif has_create %}
                                <span class="badge badge__scheduled">Will Create</span>
                            {% else %}
                                <span class="badge badge__published">Ready</span>
                            {% endif %}
                        </td>

                    {% elseif import_type == 'category' %}
                        <td><strong>{{ item.title }}</strong></td>
                        <td><code>{{ item.fullPath|default(item.title)|replace({'/': ' > '}) }}</code></td>
                        <td>
                            {% if item_warnings|length > 0 %}
                                <span class="badge badge__scheduled">Update</span>
                            {% else %}
                                <span class="badge badge__published">New</span>
                            {% endif %}
                        </td>
                    {% endif %}
                    </tr>

                    {# Warning details expanded row #}
                    {% if item_warnings|length > 0 %}
                        <tr class="import-warning-row">
                            <td colspan="{{ col_span }}">
                                <ul class="import-warnings">
                                    {% for w in item_warnings %}
                                        {% set w_type = w.type ?? 'general' %}
                                        {% set w_title = w.title ?? (w is iterable ? w|json_encode : w) %}

                                        {% if w_type == 'link' %}
                                            <li class="import-status import-status--link">
                                                <span class="material-icons" aria-hidden="true">link</span>
                                                <strong>{{ w_title }}</strong> — exists and will be linked
                                            </li>
                                        {% elseif w_type == 'create' or w_type in ['category_create', 'tag_create'] %}
                                            <li class="import-status import-status--create">
                                                <span class="material-icons" aria-hidden="true">add_circle_outline</span>
                                                <strong>{{ w_title }}</strong> — will be created
                                            </li>
                                        {% elseif w_type == 'missing' %}
                                            <li class="import-status import-status--missing">
                                                <span class="material-icons" aria-hidden="true">warning</span>
                                                <strong>{{ w_title }}</strong> — missing and <em>will not</em> be linked
                                            </li>
                                        {% else %}
                                            <li class="import-status import-status--error">
                                                <span class="material-icons" aria-hidden="true">error_outline</span>
                                                {{ w_title }}
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
                </tbody>
            </table>

            <div class="fixed-bottom-bar">
                <p>
                    <a href="{{ path('incp_tools_import') }}" class="btn btn--secondary">Cancel</a>
                    <button class="btn btn--primary" type="submit">
                        <span class="material-icons" aria-hidden="true">sync</span>
                        <span class="btn--text">Process Import</span>
                    </button>
                </p>
            </div>
        </form>
    </section>
</div>
{% endblock content %}