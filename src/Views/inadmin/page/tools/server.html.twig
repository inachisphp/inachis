{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incp_security_list') }}">Security &amp; Diagnostics</a>
    <span>System Status</span>
{% endblock pagetitle %}


{% block content %}
<div class="col-12">
{% if environment != 'prod' %}
    {% include 'inadmin/partials/flashes.html.twig' with {
        flashMessages: {
            notice: [
                "This is a #{environment} environment so may be configured to output errors.",
            ]
        }
    } %}
{% endif %}

<div class="diagnostics-toolbar mb-4">
    <a href="{{ viewModel.settings.domain ~ path('incp_tools_diagnostics_json') }}" class="btn btn--secondary">
        <span class="material-icons" aria-hidden="true">download</span>
        <span class="btn-text">Download Report</span></a>
        <button type="button" id="toggle-errors-btn" class="btn btn--outline">
            <span class="material-icons" aria-hidden="true">filter_alt</span>
            <span class="btn-txt">Show Issues Only</span>
        </button>
</div>

{% include 'inadmin/partials/diagnostics/summary.html.twig' with { summary: summary } %}

{% for section in sections %}
    <section>
        <h2>{{ section.label }}</h2>

        <table class="table table--responsive table--striped">
            <thead>
            <tr>
                <th>Check</th>
                <th>Status</th>
                <th class="hide-on-mobile">Value</th>
{% if section.label == 'Security' %}
                <th class="hide-on-mobile">Severity</th>
{% endif %}
                <th class="hide-on-mobile">Details</th>
            </tr>
            </thead>
            <tbody>
            {% for check in section.checks %}
                <tr class="status-{{ check.status }}">
                    <td>{{ check.label }}</td>
                    <td>
                        <span class="badge badge__{{ check.status }}">
                            {{ check.status|upper }}
                        </span>
                    </td>
                    <td>{{ check.value ?? '—' }}</td>
{% if section.label == 'Security' %}
                    <td class="hide-on-mobile{% if check.severity is defined %} severity-{{ check.severity }}{% endif %}">
                        {{ check.severity|default('—') }}
                    </td>
{% endif %}
                    <td class="hide-on-mobile">
                        {{ check.details }}
                        {% if check.recommendation %}
                            <div class="text-muted small mt-1">
                                Recommendation: {{ check.recommendation }}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
{% endfor %}
</div>
<script>
// todo: move this to js file
document.addEventListener('DOMContentLoaded', () => {
  // 1. Make Diagnostics Summary Cards Clickable Scroll Targets
  const summaryCards = document.querySelectorAll('.diagnostics-summary .card');

  summaryCards.forEach(card => {
    const titleEl = card.querySelector('.card-title');
    if (!titleEl) return;

    const sectionName = titleEl.textContent.trim().toLowerCase();

    // Find matching section heading
    const targetHeading = Array.from(document.querySelectorAll('.content section h2'))
      .find(h2 => h2.textContent.trim().toLowerCase() === sectionName);

    if (targetHeading) {
      card.style.cursor = 'pointer';
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.setAttribute('title', `Jump to ${titleEl.textContent.trim()} section`);

      const scrollToSection = () => {
        // Scroll the parent section or heading taking scroll-margin-top into account
        const targetSection = targetHeading.closest('section') || targetHeading;
        targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

        // Visual highlight ring/flash
        targetHeading.classList.add('highlight-section');
        setTimeout(() => targetHeading.classList.remove('highlight-section'), 1500);
      };

      card.addEventListener('click', scrollToSection);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          scrollToSection();
        }
      });
    }
  });

  // 2. "Show Issues Only" Filter Toggle
  const filterBtn = document.getElementById('toggle-errors-btn');
  let issuesOnly = false;

  if (filterBtn) {
    filterBtn.addEventListener('click', () => {
      issuesOnly = !issuesOnly;
      const okRows = document.querySelectorAll('.table--responsive tbody tr.status-ok, .table--responsive tbody tr.status-info');

      okRows.forEach(row => {
        row.style.display = issuesOnly ? 'none' : '';
      });

      filterBtn.classList.toggle('btn--primary', issuesOnly);
      filterBtn.classList.toggle('btn--outline', !issuesOnly);
      filterBtn.querySelector('.material-icons').textContent = issuesOnly ? 'filter_alt_off' : 'filter_alt';
      filterBtn.childNodes[2].textContent = issuesOnly ? ' Show All Checks' : ' Show Issues Only';
    });
  }
});
</script>
{% endblock content %}
