{% extends "/inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <a href="{{ path('incc_tools_index') }}">Tools</a>
    <span>Analytics</span>
{% endblock pagetitle %}


{% block content %}
<!-- div class="col-6" -->
<div class="col-6 toolbar-container analytics-toolbar">
    <form class="grid-toggle" method="get">
        <button aria-pressed="{{ analytics.period.range == 'today' ? 'true' : 'false' }}" class="button button--grid" name="range" value="today">Today</button>
        <button aria-pressed="{{ analytics.period.range == 'yesterday' ? 'true' : 'false' }}" class="button button--grid" name="range" value="yesterday">Yesterday</button>
        <button aria-pressed="{{ analytics.period.range == '7d' ? 'true' : 'false' }}" class="button button--grid" name="range" value="7d">7 Days</button>
        <button aria-pressed="{{ analytics.period.range == '30d' ? 'true' : 'false' }}" class="button button--grid" name="range" value="30d">30 Days</button>
        <button aria-pressed="{{ analytics.period.range == '90d' ? 'true' : 'false' }}" class="button button--grid" name="range" value="90d">90 Days</button>
        <button aria-pressed="{{ analytics.period.range == 'this-month' ? 'true' : 'false' }}" class="button button--grid" name="range" value="this-month">Month</button>
        <button aria-pressed="{{ analytics.period.range == 'this-year' ? 'true' : 'false' }}" class="button button--grid" name="range" value="this-year">Year</button>
        <button
            aria-pressed="{{ analytics.period.range == 'custom' ? 'true' : 'false' }}"
            class="ui-toggle button button--grid"
            data-target=".analytics-custom-range"
            data-target-state="hidden"
            name="range"
            type="button"
            value="custom"
        >
            Custom…
        </button>
    </form>

        <section class="admonition admonition__info">
            <form class="analytics-custom-range visually-hidden">
                <input type="hidden" name="range" value="custom">
                <div class="form-group">
                    <label for="analytics-from">From</label>
                    <input
                        id="analytics-from"
                        name="from"
                        type="date"
                        value="{{ analytics.period.from|date('Y-m-d') }}">
                </div>

                <div class="form-group">
                    <label for="analytics-to">To</label>
                    <input
                        id="analytics-to"
                        name="to"
                        type="date"
                        value="{{ analytics.period.to|date('Y-m-d') }}">
                </div>

                <button class="button button--primary" type="submit">
                    Apply
                </button>
            </form>
            <header class="admonition__header">
                <h2>Showing {{ analytics.period.label }}</h2>
            </header>
            <p class="admonition__content">
                {{ analytics.period.from|date('jS F Y', viewModel.session.preferences.timezone) }}
                {% if analytics.period.to != analytics.period.from %}
                 &mdash; {{ analytics.period.to|date('jS F Y', viewModel.session.preferences.timezone) }}
                {% endif %}
            </p>
        </section>
</div>

<section class="col-6 widget ui-section rounded">
    <header class="widget__header">
        <h2>Overview</h2>
    </header>
    {% set cardSize = analytics.change is not null ? 'col-3' : 'col-4' %}
    <div class="widget__content nested-grid">
        <article class="{{ cardSize }} widget-stats__card widget-stats__card--total" aria-labelledby="stats-total-visits">
            <div class="widget-stats__icon" aria-hidden="true">
                <span class="material-icons">visibility</span>
            </div>
            <div class="widget-stats__content">
                <h2 id="stats-total-visits">Total Views</h2>
                <p class="widget-stats__value">{{ analytics.totalViews|number_format }}</p>
            </div>
        </article>

        <article class="{{ cardSize }} widget-stats__card widget-stats__card--unique" aria-labelledby="stats-unique-visitors">
            <div class="widget-stats__icon" aria-hidden="true">
                <span class="material-icons">group</span>
            </div>
            <div class="widget-stats__content">
                <h2 id="stats-unique-visitors">Visitors</h2>
                <p class="widget-stats__value">{{ analytics.uniqueVisitors|number_format }}</p>
            </div>
        </article>

    {% if analytics.change is not null %}
        <article class="{{ cardSize }} widget-stats__card widget-stats__card--today" aria-labelledby="stats-change">
            <div class="widget-stats__icon" aria-hidden="true">
                <span class="material-icons"> trending_{{ analytics.change > 0 ? 'up' : 'down' }}</span>
            </div>
            <div class="widget-stats__content">
                <h2 id="stats-change">Change</h2>
                <p class="widget-stats__value">{{ analytics.change|number_format }}%</p>
            </div>
        </article>
    {% endif %}

        <article class="{{ cardSize }} widget-stats__card widget-stats__card--subscribers" aria-labelledby="stats-subscribers">
            <div class="widget-stats__icon" aria-hidden="true">
                <span class="material-icons" style="color: var(--color-warning-500);">rss_feed</span>
            </div>
            <div class="widget-stats__content">
                <h2 id="stats-subscribers">Subscribers</h2>
                <p class="widget-stats__value">{{ analytics.totalSubscribers|number_format }}</p>
            </div>
        </article>
    </div>
</section>
<!-- /div -->

<section class="col-6 widget">
    <header class="widget__header">
        <h2>Traffic</h2>
    </header>
    <canvas id="trafficChart"></canvas>
</section>

<section class="col-6 widget">
    <header class="widget__header">
        <h2>Trending</h2>
    </header>
    <table>
        <thead>
            <tr>
                <th>Page</th>
                <th class="col-count">Current</th>
                <th class="col-count">Previous</th>
                <th>Change</th>
                <th class="col-count">%</th>
            </tr>
        </thead>
        <tbody>
			{% for page in analytics.trending %}
				<tr>
					<td>{{ page.title ?? page.path }}</td>
					<td class="col-count">{{ page.current }}</td>
                    <td class="col-count">{{ page.previous }}</td>
					<td {%
                        if page.change < 0 %}class="widget-stats__trend--down"{%
                        elseif page.change > 0 %}class="widget-stats__trend--up"{%
                    endif %}>
						{% if page.change is null %}
							NEW
						{% elseif page.change > 0 %}
							▲ +{{ page.change|number_format(1) }}%
						{% elseif page.change < 0 %}
							▼ {{ page.change|number_format(1) }}%
						{% else %}
							—
						{% endif %}
					</td>
                    <td class="col-count">{{ analytics.totalViews > 0 ? (page.current / analytics.totalViews * 100)|number_format(1) : 0 }}</td>
				</tr>
			{% else %}
				<tr><td colspan="4">No data</td></tr>
			{% endfor %}
		</tbody>
	</table>
</section>

<section class="col-6 widget">
    <header class="widget__header">
        <h2>Users by Region</h2>
    </header>
    <table>
        <thead>
            <tr>
                <th>Country</th>
                <th class="col-count">Hits</th>
                <th class="col-count">%</th>
            </tr>
        </thead>
        <tbody>
            {% for region in analytics.topRegions %}
                <tr>
                    <td>
                        <span style="font-weight: 600;">{{ region.country_name }}</span>
                        <span style="color: var(--color-neutral-500); font-size: 0.85rem; margin-left: 0.5rem;">({{ region.country_code }})</span>
                    </td>
                    <td class="col-count">{{ region.total|number_format }}</td>
                    <td class="col-count">
                        {% if analytics.totalViews > 0 %}
                            {{ (region.total / analytics.totalViews * 100)|number_format(1) }}%
                        {% else %}
                            0%
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3">No visits were recorded during this period.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>

<section class="col-6 widget">
    <header class="widget__header">
        <h2>Top 404s</h2>
    </header>
    <table>
        <thead>
            <tr>
                <th>Path</th>
                <th class="col-count">Hits</th>
            </tr>
        </thead>
        <tbody>
            {% for page in analytics.top404s %}
                <tr>
                    <td>{{ page.path }}</td>
                    <td class="col-count">{{ page.hits }}</td>
                </tr>
            {% else %}
                <tr><td colspan="2">No 404s were recorded during this period</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>

<section class="col-6 widget">
    <header class="widget__header">
        <h2>Top Referrers</h2>
    </header>
    <table>
        <thead>
            <tr>
                <th>Source</th>
                <th class="col-count">Visits</th>
                <th class="col-count">%</th>
            </tr>
        </thead>
        <tbody>
            {% for ref in analytics.topReferrers %}
                <tr>
                    <td>{{ ref.domain }}</td>
                    <td class="col-count">{{ ref.total }}</td>
                    <td class="col-count">{{ analytics.totalViews > 1 ? (ref.total / analytics.totalViews * 100)|number_format(1) : 0 }}</td>
                </tr>
            {% else %}
                <tr><td colspan="3">No referrers were recorded during this period.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>

<section class="col-6 widget">
    <header class="widget__header">
        <h2>Bot Traffic</h2>
    </header>
    <table>
        <thead>
            <tr>
                <th>User Agent</th>
                <th class="col-count">Hits</th>
            </tr>
        </thead>
        <tbody>
            {% for bot in analytics.topBots %}
                <tr>
                    <td style="font-family: monospace; font-size: 0.85rem; word-break: break-all;">{{ bot.user_agent }}</td>
                    <td class="col-count">{{ bot.total|number_format }}</td>
                </tr>
            {% else %}
                <tr><td colspan="2">No bot traffic was recorded during this period</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>

<section class="col-6 widget">
    <header class="widget__header">
        <h2>RSS Subscribers</h2>
    </header>
    <canvas id="subscribersChart"></canvas>
</section>

<section class="col-6 widget">
    <header class="widget__header">
        <h2>RSS Feed Subscribers</h2>
    </header>
    <table>
        <thead>
            <tr>
                <th>Feed Path</th>
                <th class="col-count">Subscribers</th>
            </tr>
        </thead>
        <tbody>
            {% for feed in analytics.subscribersPerFeed %}
                <tr>
                    <td><code class="inline">{{ feed.path }}</code></td>
                    <td class="col-count">{{ feed.subscribers|number_format }}</td>
                </tr>
            {% else %}
                <tr><td colspan="2">No subscriber history exists for this period</td></tr>
            {% endfor %}
        </tbody>
    </table>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const views = {{ analytics.viewsPerDay|map(v => v.total)|json_encode|raw }}
        .map(v => Number(v) || 0);
    const avg = views.reduce((a, b) => a + b, 0) / views.length;
    const avgLine = views.map(() => avg);
    const data = {
        labels: {{ analytics.viewsPerDay|map(v => v.date)|json_encode|raw }},
        datasets: [
            {
                label: 'Views',
                data: {{ analytics.viewsPerDay|map(v => v.total)|json_encode|raw }},
                fill: false,
                tension: 0.2
            },
            {
                label: 'Average Views',
                data: avgLine,
                borderDash: [5, 5],
                fill: false,
                tension: 0
            }
        ]
    };
    new Chart(
        document.getElementById('trafficChart'),
        {
            type: 'line',
            data: data,
        }
    );

    const subsData = {
        labels: {{ analytics.subscriberStats|map(s => s.date)|json_encode|raw }},
        datasets: [
            {
                label: 'RSS Subscribers',
                data: {{ analytics.subscriberStats|map(s => s.subscribers)|json_encode|raw }},
                fill: false,
                tension: 0.2,
                borderColor: '#f26522',
                backgroundColor: '#f26522',
            }
        ]
    };
    new Chart(
        document.getElementById('subscribersChart'),
        {
            type: 'line',
            data: subsData,
        }
    );
</script>

{% endblock content %}