{% extends "inadmin/structure/main.html.twig" %}

{% block pagetitle %}
    <span>{{ viewModel.page.type|title }}</span>
{% endblock pagetitle %}

{% set imageAddButton = can('IMAGE', 'CREATE') ? {
    class: 'dialog__link',
    data: {
        'class-name': 'dialog__imageManager',
        dialog: 'imageManager',
        'template-name': 'image-manager',
        title: 'admin.dialog.upload.title'|trans,
        view: 'upload',
        'allowed-types': allowedTypes|default([])|join(','),
    },
    text: 'Upload a new image',
    image: 'cloud_upload',
    type: 'button',
    url: '#',
} : null %}

{% set downloadAddButton = can('DOWNLOAD', 'CREATE') ? {
    class: 'dialog__link',
    data: {
        'class-name': 'dialog__uploadManager',
        dialog: 'uploadManager',
        'template-name': 'upload-manager',
        title: 'admin.dialog.upload.title'|trans,
        view: 'upload',
        'allowed-types': allowedTypes|default([])|join(','),
    },
    text: 'Upload a new Download file',
    image: 'cloud_upload',
    type: 'button',
    url: '#',
} : null %}

{% set columns = [
    {
        title: 'Title',
        slug: 'id',
        source: 'title',
    },
    {
        title: 'admin.resources.properties.filename'|trans,
        hideOnMobile: true,
        source: 'filename',
    }
] %}
{% if viewModel.page.tab == 'image' %}
    {% set columns = columns|merge([{
        title: 'admin.resources.properties.dimensions'|trans,
        source: 'dimensionsString',
    }]) %}
{% endif %}
{% set columns = columns|merge([{
        title: 'admin.resources.properties.filesize'|trans,
        source: 'filesize',
        source_type: 'numeric',
}]) %}


{% block content %}
<div class="col-12">
    <ul class="ui-tabs">
        <li role="tab" class="{% if viewModel.page.tab == 'image' %} ui-state-active{% endif %}">
            <a href="{{ viewModel.settings.domain ~ path('incp_resource_list', { type: 'images' }) }}">Images</a>
        </li>
        <li role="tab" class="{% if viewModel.page.tab == 'download' %} ui-state-active{% endif %}">
            <a href="{{ viewModel.settings.domain ~ path('incp_resource_list', { type: 'downloads' }) }}">Downloads</a>
        </li>
    </ul>

    {{ include ('inadmin/partials/components/view_content.html.twig', {
        add_button: viewModel.page.tab == 'image' ? imageAddButton : downloadAddButton,

        columns: columns,

        filters: {
            Usage: {
                '': 'All',
                'notinuse': 'Not in use',
            },
            Duplicates: {
                '': 'All',
                'duplicates': 'Duplicates',
                'unique': 'Unique',
            },
        },
        filter_values: query.filters,

        limit: query.limit,
        offset: query.offset,

        'slug_prefix': 'resources/' ~ viewModel.page.type,
        'slug': 'id',

        total: dataset.count,
        type: viewModel.page.tab,
        url_result: path('incp_resource_list', { type: viewModel.page.type }),

        show_search: true,
        sort_options: {
            'createdAt desc': 'Uploaded: Newest',
            'createdAt asc': 'Uploaded: Oldest',
            'updatedAt desc': 'Modified: Newest',
            'updatedAt asc': 'Modified: Oldest',
            'filesize asc': 'Size: Smallest',
            'filesize desc': 'Size: Largest',
            'title asc': 'Title: A-Z',
            'title desc': 'Title: Z-A',
        },
        view_modes: [ 'grid', 'table' ],
        view_setting: query.view|default('grid'),
        zebra: true,
    }) }}


{% if showUploadDialog|default(false) %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            window.document.querySelector('[data-view="upload"]').click();
        });
    </script>
{% endif %}
</div>
{% endblock content %}