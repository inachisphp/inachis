{% set tableClasses = [
    'table',
    table_class|default(null),
    zebra is defined and zebra ? 'table--striped',
    show_select_deselect is defined and show_select_deselect  ? 'table--selectable',
    sortable is defined and sortable ? 'table--dragdrop',
]|filter(v => v) %}

{% if table_desc|default('') is not empty %}
<p id="table-desc" class="visually-hidden">
    {{ table_desc }}
</p>
{% endif %}
<table {%- if table_desc|default('') is not empty %} aria-describedby="table-desc"{% endif %} class="{{ tableClasses|join(' ') }}">
    {%if table_name|default(null) %}<caption class="visually-hidden">{{ table_name }}</caption>{% endif %}
    <thead>
        <tr>
        {% if sortable is defined and sortable %}
            <th scope="col"></th>
        {% endif %}
        {% if actions|default(null) is not empty %}
            <th class="col-select" scope="col">
                <label for="select-all" class="visually-hidden">Select all rows</label>
                <input aria-label="Select all rows" class="selectAllNone" id="select-all" name="selectAllNone" type="checkbox"  />
            </th>
        {% endif %}
        {% for column in columns %}
            {% set cellClasses = [
                column.badges|default([]) is not empty ? 'badgecol',
                column.hideOnMobile|default(false) ? 'hide-on-mobile',
                column.source_type|default('') in [ 'numeric', 'count' ] ? 'col-count',
                column.source_type|default('') in [ 'boolean', 'date' ] ? 'col-date',
                column.source_type|default('') == 'datetime' ? 'col-datetime',
            ]|filter(v => v) %}

            <th class="{{ cellClasses|join(' ') }}" scope="col">
                {{ column.title }}
            </th>
        {% endfor %}
        {% if (sortable is defined and sortable) or (show_action_list is defined and show_action_list) %}
            <th class="col-actions" scope="col">Actions</th>
        {% endif %}
        </tr>
    </thead>
    <tbody>
    {% if dataset.iterator|default(null) %}{% set dataset = dataset.iterator %}{% endif %}
    {% for item in dataset %}
        {% set rowClasses = [] %}
        {% for rule in rowHighlighting|default([]) %}
            {% if property(item, rule.field) == rule.equals %}
                {% set rowClasses = rowClasses|merge([rule.className]) %}
            {% endif %}
        {% endfor %}
        <tr{% if rowClasses is not empty %} class="{{ rowClasses|join(' ') }}"{% endif %}>
        {% if sortable is defined and sortable %}
            <td class="handle">☰</td>
        {% endif %}
        {% if actions|default(null) is not empty %}
            <td class="col-select">
                <input class="checkbox" id="{{ type }}-{{ item.id }}__input" type="checkbox" name="items[]" value="{{ item.id }}" />
            </td>
        {% endif %}
        {% for column in columns %}
            {# Calculate URL if required #}
            {% if column.slug is defined %}
                {% set slug_object = property(item, column.slug) %}
            {% elseif column.path is defined %}
                {% set path_params = {} %}

                {% for paramName, paramSource in column.path_params %}
                    {% set path_params = path_params|merge({
                        (paramName): property(item, paramSource|replace({'item.': ''}))|default(null)
                    }) %}
                {% endfor %}

                {% set url = path(column.path, path_params) %}
            {% endif %}
            {# Calculate cell classes #}
            {% set cellClasses = [
                column.flex|default(false) ? 'table--flex',
                column.source_type|default('') in ['numeric', 'count'] ? 'col-count',
                column.source_type|default('') in ['boolean', 'date'] ? 'col-date',
                column.source_type|default('') == 'datetime' ? 'col-datetime',
                column.badges|default([]) is not empty ? 'badgecol',
                column.hideOnMobile|default(false) ? 'hide-on-mobile',
                column.className is defined ? (
                    column.className == 'use_self'
                        ? property(item, column.source)
                        : column.className
                ),
            ]|filter(v => v) %}
            <{% if column.header is defined and column.header %}th scope="row"{% else %}td class="{{ cellClasses|join(' ') }}"{% endif %}>
                {% if column.slug is defined %}
                    {% if column.slug_prefix is defined %}
                        <a aria-label="Edit {{ attribute(item, column.source) }}" href="/incc/{{ attribute(item, column.slug_prefix) }}/{{ slug_object }}">
                    {% elseif slug_prefix is defined %}
                        <a aria-label="Edit {{ attribute(item, column.source) }}" href="/incc/{{ slug_prefix }}/{{ slug_object }}">
                    {% endif %}
                {% elseif column.url is defined and column.url is not empty %}
                        <a aria-label="Edit {{ attribute(item, 'title') }}" href="{{ attribute(item, column.url) }}">
                {% elseif url is defined and url is not empty and column.path is defined %}
                        <a aria-label="Edit" href="{{ url }}">
                {% endif %}
                {% if column.source is defined and attribute(item, column.source) is defined %}
                    {% if column.source_type is defined and column.source_type == 'date' %}
                        {{ attribute(item, column.source)|date('d/m/Y', viewModel.session.preferences.timezone) }}
                    {% elseif column.source_type is defined and column.source_type == 'datetime' %}
                        {{ attribute(item, column.source)|date(column.dateFormat|default('d/m/Y H:i'), viewModel.session.preferences.timezone) }}
                    {% elseif column.source_type is defined and column.source_type == 'title' %}
                        {{ property(item, column.source ~ '.title') }}
                    {% elseif column.source_type is defined and column.source_type == 'count' %}
                        {{ attribute(item, column.source)|length }}
                    {% elseif column.source_type is defined and column.source_type == 'boolean' %}
                        {{ attribute(item, column.source) ? 'Yes' : 'No' }}
                    {% elseif column.source_type is defined and column.source_type == 'object' %}
                        {% if attribute(item, column.source) is iterable %}
                            {% for object in attribute(item, column.source) %}
                                {{ attribute(object, column.object_field)}}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}
                            {{ attribute(attribute(item, column.source), column.object_field)|default('-') }}
                        {% endif %}
                    {% else %}
                        {% if column.maxLength is defined %}
                            {{ attribute(item, column.source)|slice(0, column.maxLength) }}
                            {% if attribute(item, column.source)|length > column.maxLength %}…{% endif %}
                        {% else %}
                            {{ attribute(item, column.source)|default('-') }}
                        {% endif %}
                    {% endif %}
                {% elseif column.badges|default(null) is not empty %}
                    {% include 'inadmin/partials/badge.html.twig' with {
                        badges: column.badges,
                    } %}
                {% endif %}
                {% if column.slug is defined or (column.url is defined and column.url is not empty) %}
                    </a>
                {% endif %}
            </{% if column.header is defined and column.header %}th{% else %}td{% endif %}>
        {% endfor %}
        {% if sortable is defined and sortable %}
            <td>
                {% if not loop.first %}<button class="move-up">↑</button>{% endif %}
                {% if not loop.last %}<button class="move-down">↓</button>{% endif %}
            </td>
        {% endif %}
        </tr>
    {% endfor %}
    </tbody>
</table>